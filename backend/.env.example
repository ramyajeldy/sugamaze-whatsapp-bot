# Copy to .env and fill in. Get the API key from console.anthropic.com
# (this is the Developer Platform — separate from your Claude Pro subscription).
ANTHROPIC_API_KEY=sk-ant-...

# Model: Sonnet 4.6 is a good cost/quality default for grounded Q&A.
# For a cheaper, faster bot try claude-haiku-4-5-20251001.
CLAUDE_MODEL=claude-sonnet-4-6

# Get a free API key at voyageai.com
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3.5-lite
CHROMA_DIR=./chroma_data
TOP_K=5
MAX_DISTANCE=0.75
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Rebuild every tenant's vector store on startup (self-healing). Leave true in
# production; set false locally to reuse existing chroma_data and skip the
# several-minute reseed.
AUTOSEED_ON_STARTUP=true

# WhatsApp (Meta Cloud API) — from developers.facebook.com / business.facebook.com
# One Meta App / one webhook URL serves every tenant. Make up any string for
# the verify token; enter the SAME value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=groundedbot-verify-me

# Per-tenant WhatsApp access tokens. One env var per tenant, named
# WHATSAPP_TOKEN__<TENANT_ID_UPPER> to match a backend/tenants/<id>.yaml file.
# The tenant's phone_number_id, escalation contacts, prompt, and canned
# messages all live in that YAML — only the secret token belongs here.
WHATSAPP_TOKEN__SUGAMAZE=
# WHATSAPP_TOKEN__BESTBRAINS_MAVIS=

# Email (SMTP) — Gmail example. Shared sender for all tenants; each tenant's
# recipient address is set in its own YAML config.
# For Gmail: generate an App Password at myaccount.google.com/apppasswords (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Admin panel login (visit /admin) — CHANGE these before deploying.
# Single operator account covering all tenants.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
